      "options": [
        "none - None",
        "525_1dd - 5.25\" 180k",
        "525_2dd - 5.25\" 360k",
        "525_2qd - 5.25\" 720k",
        "525_2hd - 5.25\" 1.2M",
        "35_1dd - 3.5\" 360k",
        "35_2dd - 3.5\" 720k",
        "35_2hd - 3.5\" 1.44M",
        "35_2ed - 3.5\" 2.88M"
