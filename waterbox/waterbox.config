  "settings": [
    {
      "name": "machine",
      "display": "setting.machine",
      "type": "enum",
      "default": "xi8088 - [8088] Xi8088",
      "options": [
        "xi8088 - [8088] Xi8088",
        "ibmpc - [8088] IBM PC (1981)",
        "ibmpc82 - [8088] IBM PC (1982)",
        "ibmxt - [8088] IBM XT (1982)",
        "ibmat - [ISA] IBM AT"
      ],
      "description": "setting.machine.about"
    },
    {
      "name": "bios",
      "display": "setting.bios",
      "type": "enum",
      "default": "auto - the machine's default BIOS",
      "options": [
        "auto - the machine's default BIOS",
        "ibm5150_5700671 - 5700671 (10/19/81)",
        "ibm5150_5700051 - 5700051 (04/24/81)",
        "glabios_040_8088 - GLaBIOS 0.4.0 (8088)",
        "glabios_040_v20 - GLaBIOS 0.4.0 (V20)",
        "ibm5150_1501476 - 1501476 (10/27/82)",
        "ibm5150_5000024 - 5000024 (08/16/82)",
        "ibm5160_1501512_5000027 - 1501512 (11/08/82)",
        "ibm5160_1501512_6359116 - 1501512 (11/08/82) (Alt)",
        "ibm5160_5000026_5000027 - 5000026 (08/16/82)",
        "ibm5170_111585 - 62X082x (11/15/85)",
        "ibm5170_111585_alt - 61X9266 (11/15/85) (Alt)",
        "ibm5170_061085 - 648009x (06/10/85)",
        "ibm5170_011084 - 618102x (01/10/84)"
      ],
      "description": "setting.bios.about"
    },
    {
      "name": "cpu",
      "display": "setting.cpu",
      "type": "enum",
      "default": "auto - the machine's first processor",
      "options": [
        "auto - the machine's first processor",
        "8088/4772728 - 8088 4.77 MHz",
        "8088/7159092 - 8088 7.16 MHz",
        "8088/8000000 - 8088 8 MHz",
        "8088/10000000 - 8088 10 MHz",
        "8088/12000000 - 8088 12 MHz",
        "8088/16000000 - 8088 16 MHz",
        "necv20/4772728 - V20 4.77 MHz",
        "necv20/7159092 - V20 7.16 MHz",
        "necv20/8000000 - V20 8 MHz",
        "necv20/10000000 - V20 10 MHz",
        "necv20/12000000 - V20 12 MHz",
        "necv20/16000000 - V20 16 MHz",
        "286/6000000 - 80286 6 MHz",
        "286/8000000 - 80286 8 MHz"
      ],
      "description": "setting.cpu.about"
    },
    {
      "name": "fpu",
      "display": "setting.fpu",
      "type": "enum",
      "default": "none - None",
      "options": [
        "none - None",
        "8087 - 8087",
        "287 - 287",
        "287xl - 287XL"
      ],
      "description": "setting.fpu.about"
    },
    {
      "name": "memoryKB",
      "display": "setting.memorykb",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 1024,
      "description": "setting.memorykb.about"
    },
    {
      "name": "video",
      "display": "setting.video",
      "type": "enum",
      "default": "cga - IBM CGA",
      "options": [
        "cga - IBM CGA",
        "mda - IBM MDA",
        "hercules - Hercules",
        "ega - IBM EGA",
        "vga - IBM VGA"
      ],
      "description": "setting.video.about"
    },
    {
      "name": "sound",
