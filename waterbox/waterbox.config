{
  "coreName": "86Box",
  "systemId": "PC",
  "systemNames": {
    "PC": "IBM PC compatible"
  },
  "author": "the 86Box developers (after PCem by Sarah Walker); chimera port",
  "url": "https://github.com/ToolAssisted-run/chimera-core-86box",
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    64,
    4,
    16,
    64,
    1024
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. 86Box allocates the machine's RAM, its lookup tables, the 2048x2112 screen bitmap and the 16 MB frame buffer with mmap and malloc, which musl sends to the mmap arena; an XT or AT is a few MB of state. The arena is a reservation, committed as it is touched.",
  "video": {
    "_comment": "The capacity: 86Box draws into a 2048x2048 bitmap. The live size comes from GetVideoWidth/Height every frame: 640x200 for CGA text, 720x350 for MDA, 640x480 for VGA.",
    "width": 2048,
    "height": 2048,
    "virtualWidth": 640,
    "virtualHeight": 480,
    "vsyncNumerator": 100,
    "vsyncDenominator": 1,
    "_vsync_note": "A frame is a slice of machine time, not a scanout: 10 ms at 100 frames a second, the PCem core's cadence. The framesPerSecond setting changes it.",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "The cards' sound at 48000 Hz, with FM, wavetable and CD audio converted to it (waterbox/chimera-audio.c). 86Box hands it over in 20 ms blocks, so a 10 ms frame has a block or none.",
    "samplesPerFrame": 48000,
    "channels": 2,
    "rate": 48000,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".img": "PC",
    ".ima": "PC",
    ".dsk": "PC",
    ".vfd": "PC",
    ".fdi": "PC",
    ".86f": "PC",
    ".td0": "PC",
    ".imd": "PC",
    ".mfm": "PC"
  },
