    {
      "name": "mouse",
      "display": "setting.mouse",
      "type": "enum",
      "default": "none - None",
      "options": [
        "none - None",
        "msserial - Microsoft Serial Mouse",
        "mssystems - Mouse Systems Serial Mouse",
        "logibus - Logitech/Microsoft Bus Mouse",
        "msbus - Microsoft Bus Mouse (InPort)",
        "ps2 - PS/2 Mouse"
      ],
      "description": "setting.mouse.about"
    },
    {
      "name": "joystick",
      "display": "setting.joystick",
      "type": "enum",
      "default": "none - None",
      "options": [
        "none - None",
        "2axis_2button - 2-axis, 2-button joystick(s)",
        "2axis_4button - 2-axis, 4-button joystick",
        "4axis_4button - 4-axis, 4-button joystick",
        "2button_gamepad - 2-button gamepad(s)",
        "4button_gamepad - 4-button gamepad",
        "ch_flightstick_pro - CH Flightstick Pro",
        "thrustmaster_fcs - Thrustmaster Flight Control System",
        "sidewinder_pad - Microsoft SideWinder Pad"
      ],
      "description": "setting.joystick.about"
    },
    {
      "name": "hardDiskController",
      "display": "setting.harddiskcontroller",
      "type": "enum",
      "default": "none - None",
      "options": [
        "none - None",
        "xtide - PC/XT XTIDE",
        "xtide_at_1ch - PC/AT XTIDE (Primary Only)"
      ],
      "description": "setting.harddiskcontroller.about"
    },
    {
      "name": "clockStart",
      "display": "setting.clockstart",
      "type": "datetime",
      "default": 946684800,
      "min": 0,
      "max": 7258118400,
      "description": "setting.clockstart.about"
    },
    {
      "name": "framesPerSecond",
      "display": "setting.framespersecond",
      "type": "int",
      "default": 100,
      "min": 1,
      "max": 1000,
      "description": "setting.framespersecond.about"
    }
  ],
