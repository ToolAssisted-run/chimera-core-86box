+#ifdef CHIMERA_CORE
+/* A Chimera core reads its configuration from memory (a stream fmemopen
+ * made), and the C library cannot read wide characters from such a stream:
+ * glibc crashes in fgetws. A line is read as bytes and each byte widened, so
+ * both builds of the core read it the same way and the bytes of a file name
+ * come through as they were. */
+static wchar_t *
+ini_fgets_bytes(wchar_t *str, int count, FILE *stream)
+{
+    char line[1024];
+    int  i;
+
+    if (!fgets(line, sizeof(line), stream)) {
+        str[0] = 0;
+        return NULL;
+    }
+    for (i = 0; line[i] && (i < (count - 1)); i++)
+        str[i] = (wchar_t) (unsigned char) line[i];
+    str[i] = 0;
+    return str;
+}
+#endif
+
